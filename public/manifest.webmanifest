{
  "name": "PixelKin",
  "short_name": "PixelKin",
  "description": "A retro, handheld-era creature-collecting adventure. Relight the sky over Vesperholm, one constellation at a time.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
