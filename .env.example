# Copy to .env and fill in. .env is git-ignored — never commit real keys.
# In this project's managed environment these are already provided as env vars,
# so a local .env is only needed when running outside it.

# --- Image generation (generate-image skill) ---
# Preferred provider: Google Gemini "Nano Banana Pro"
GOOGLE_AI_STUDIO_API_KEY=
# Optional model override (defaults to gemini-3-pro-image-preview)
# GOOGLE_IMAGE_MODEL=

# Fallback provider: OpenAI gpt-image-2
OPENAI_API_KEY=
# Optional model override (defaults to gpt-image-2)
# OPENAI_IMAGE_MODEL=

# --- Music generation (generate-music skill) ---
ELEVENLABS_API_KEY=
# Optional: switch model when Music v2 reaches the public API (defaults to music_v1)
# ELEVENLABS_MUSIC_MODEL=music_v1
# Optional: output format (defaults to mp3_44100_128; 192kbps needs Creator tier)
# ELEVENLABS_MUSIC_OUTPUT_FORMAT=mp3_44100_128
